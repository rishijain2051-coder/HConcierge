# HConcierge — local env. Gitignored. Never commit.
DATABASE_URL=postgresql://user:password@host:6543/postgres
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Live updates listen on a Postgres session. :6543 is pgbouncer in transaction
# mode, which silently drops LISTEN, so the listener uses the session pooler on
# :5432 instead. Leave this unset and it is derived from DATABASE_URL by
# swapping the port — set it only if your session endpoint is somewhere else.
# Without a working listener the app still works; it falls back to slow polling.
DATABASE_URL_SESSION=

# Optional WhatsApp/SMS escalation (Twilio). Escalation no-ops if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# e.g. whatsapp:+14155238886 for the Twilio WhatsApp sandbox, or +1... for SMS

# Base URL used when printing room QR codes
NEXT_PUBLIC_BASE_URL=http://localhost:3000
