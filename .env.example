# HConcierge — local env. Gitignored. Never commit.
DATABASE_URL=postgresql://user:password@host:6543/postgres
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Live updates listen on a Postgres session. :6543 is pgbouncer in transaction
# mode, which silently drops LISTEN, so the listener uses the session pooler on
# :5432 instead. Leave this unset and it is derived from DATABASE_URL by
# swapping the port — set it only if your session endpoint is somewhere else.
# Without a working listener the app still works; it falls back to slow polling.
DATABASE_URL_SESSION=

# Optional WhatsApp/SMS escalation (Twilio). Escalation no-ops if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# e.g. whatsapp:+14155238886 for the Twilio WhatsApp sandbox, or +1... for SMS

# Push notifications to staff devices (Web Push / VAPID).
#
# Leave these unset in development and a throwaway keypair is generated per
# process, so push works with no setup at all. Subscriptions made against a
# throwaway key die when the server restarts - which is exactly why production
# must set a real pair, and why unset keys in production switch push off
# instead of improvising one.
#
# Generate a pair:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=publicKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+privateKey.export({format:'der',type:'pkcs8'}).toString('base64url'))"
#
# Rotating them unsubscribes every device: the browser subscribed to the old
# public key and the push service will refuse a send signed by the new one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if this sender misbehaves. Never shown
# to anybody being notified.
VAPID_SUBJECT=mailto:ops@example.com

# Base URL used when printing room QR codes
NEXT_PUBLIC_BASE_URL=http://localhost:3000
