# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template, never the real one
!.env.example

# local bridge logs
.logs/


# godaudits output
.godaudits/

# marketing — the scenes, the brand source and the renderer are local-only
# now, so nothing under here is pushed again. Still on disk, and still in
# history from 20b9d93 if it is ever needed back.
/marketing

# agent tooling — skills and audit scaffolding installed per machine, not part
# of the product. .claude/launch.json stays tracked: it is how the dev server
# is started here, and every session needs it.
.agents/
.claude/skills/
skills-lock.json
